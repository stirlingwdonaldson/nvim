  "fetch helper": {
    "prefix": ";api",
    "description": "Insert a typed fetch helper",
    "body": [
      "export interface FetchResult<T> {",
      "  data: T | null;",
      "  error: string | null;",
      "}",
      "",
      "export const fetch${1:Data} = async (url: string): Promise<FetchResult<any>> => {",
      "  try {",
      "    const response = await fetch(url);",
      "    if (!response.ok) {",
      "      throw new Error(`HTTP error! status: \\${response.status}`);",
      "    }",
      "    const data = await response.json();",
      "    return { data, error: null };",
      "  } catch (error: any) {",
      "    return { data: null, error: error.message || 'An unexpected error occurred' };",
      "  }",
      "};"
    ]
  },
  "React context": {
    "prefix": ";context",
    "description": "Insert a React context/provider pair",
    "body": [
      "import React, { createContext, useContext, useState, ReactNode } from 'react';",
      "",
      "interface ${1:AppContext}Type {",
      "  data: any;",
      "  setData: React.Dispatch<React.SetStateAction<any>>;",
      "}",
      "",
      "const ${1} = createContext<${1}Type | undefined>(undefined);",
      "",
      "export const ${2:AppProvider}: React.FC<{ children: ReactNode }> = ({ children }) => {",
      "  const [data, setData] = useState<any>(null);",
      "",
      "  return (",
      "    <${1}.Provider value={{ data, setData }}>",
      "      {children}",
      "    </${1}.Provider>",
      "  );",
      "};",
      "",
      "export const use${1} = () => {",
      "  const context = useContext(${1});",
      "  if (context === undefined) {",
      "    throw new Error('use${1} must be used within an ${2}');",
      "  }",
      "  return context;",
      "};"
    ]
  },
  "A3 page shell": {
