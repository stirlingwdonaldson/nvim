  "A3 context provider": {
    "prefix": ["a3context", ";a3context"],
    "description": "Typed context provider for A3 API state",
    "body": [
      "import { createContext, useContext, useState, type ReactNode } from 'react';",
      "import { ${1:fetchResult}, type ${2:ApiRequest}, type ${3:ApiResponse} } from '../lib/${4:api}';",
      "",
      "interface ${5:TaskContextValue} {",
      "  result: ${3:ApiResponse} | null;",
      "  loading: boolean;",
      "  error: string;",
      "  calculate: (request: ${2:ApiRequest}) => Promise<void>;",
      "}",
      "",
      "const ${6:TaskContext} = createContext<${5:TaskContextValue} | undefined>(undefined);",
      "",
      "export function ${7:TaskProvider}({ children }: { children: ReactNode }) {",
      "  const [result, setResult] = useState<${3:ApiResponse} | null>(null);",
      "  const [loading, setLoading] = useState(false);",
      "  const [error, setError] = useState('');",
      "",
      "  const calculate = async (request: ${2:ApiRequest}) => {",
      "    setLoading(true);",
      "    setError('');",
      "",
      "    try {",
      "      const data = await ${1:fetchResult}(request);",
      "      setResult(data);",
      "    } catch (err) {",
      "      setResult(null);",
      "      setError(err instanceof Error ? err.message : 'Unexpected API error');",
      "    } finally {",
      "      setLoading(false);",
      "    }",
      "  };",
      "",
      "  return (",
      "    <${6:TaskContext}.Provider value={{ result, loading, error, calculate }}>",
      "      {children}",
      "    </${6:TaskContext}.Provider>",
      "  );",
      "}",
      "",
      "export function use${8:Task}() {",
      "  const context = useContext(${6:TaskContext});",
      "",
      "  if (!context) {",
      "    throw new Error('use${8:Task} must be used inside ${7:TaskProvider}');",
      "  }",
      "",
      "  return context;",
      "}"
    ]
  },
  "A3 controlled form": {
    "prefix": ["a3form", ";a3form"],
    "description": "Controlled React form with validation errors",
    "body": [
      "import { useState, type ChangeEvent, type FormEvent } from 'react';",
      "import { validate${1:FormValues}, type ${1:FormValues}, type ${1:FormValues}Errors } from '../lib/${2:validation}';",
      "import { use${3:Task} } from '../context/${4:TaskContext}';",
      "",
      "const initialValues: ${1:FormValues} = {",
      "  ${5:name}: '',",
      "  ${6:email}: '',",
      "};",
      "",
      "export default function ${7:TaskForm}() {",
      "  const [values, setValues] = useState<${1:FormValues}>(initialValues);",
      "  const [errors, setErrors] = useState<${1:FormValues}Errors>({});",
      "  const { calculate } = use${3:Task}();",
      "",
      "  const handleChange = (event: ChangeEvent<HTMLInputElement>) => {",
      "    const { name, value } = event.target;",
      "    setValues((current) => ({ ...current, [name]: value }));",
      "  };",
      "",
      "  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {",
      "    event.preventDefault();",
      "",
      "    const nextErrors = validate${1:FormValues}(values);",
      "    setErrors(nextErrors);",
      "",
      "    if (Object.keys(nextErrors).length > 0) {",
      "      return;",
      "    }",
      "",
      "    await calculate(values);",
      "  };",
      "",
      "  return (",
      "    <form className=\"space-y-4\" onSubmit={handleSubmit}>",
      "      <label className=\"block\">",
      "        <span className=\"text-sm font-medium\">${8:Name}</span>",
      "        {errors.${5:name} && <p className=\"text-sm text-red-600\">{errors.${5:name}}</p>}",
      "        <input",
      "          className=\"mt-1 w-full rounded-md border px-3 py-2\"",
      "          name=\"${5:name}\"",
      "          value={values.${5:name}}",
      "          onChange={handleChange}",
      "        />",
      "      </label>",
      "",
      "      <label className=\"block\">",
      "        <span className=\"text-sm font-medium\">${9:Email}</span>",
      "        {errors.${6:email} && <p className=\"text-sm text-red-600\">{errors.${6:email}}</p>}",
      "        <input",
      "          className=\"mt-1 w-full rounded-md border px-3 py-2\"",
      "          name=\"${6:email}\"",
      "          value={values.${6:email}}",
      "          onChange={handleChange}",
      "        />",
      "      </label>",
      "",
      "      <button className=\"rounded-md bg-blue-700 px-4 py-2 font-medium text-white\" type=\"submit\">",
      "        ${10:Calculate}",
      "      </button>",
      "    </form>",
      "  );",
      "}"
    ]
  },
  "A3 loading result block": {
    "prefix": ["a3loading", ";a3loading"],
    "description": "Loading, error, and result UI block",
    "body": [
      "const { result, loading, error } = use${1:Task}();",
      "",
      "if (loading) {",
      "  return <p className=\"rounded-md bg-blue-50 p-4 text-blue-700\">Loading result...</p>;",
      "}",
      "",
      "if (error) {",
      "  return <p className=\"rounded-md bg-red-50 p-4 text-red-700\">{error}</p>;",
      "}",
      "",
      "if (!result) {",
      "  return <p className=\"rounded-md bg-slate-50 p-4 text-slate-600\">Submit the form to see the result.</p>;",
      "}",
      "",
      "return (",
      "  <div className=\"rounded-md bg-green-50 p-4 text-green-800\">",
      "    <p className=\"text-lg font-semibold\">${2:Result}: {result.${3:result}}</p>",
      "  </div>",
      ");"
    ]
  },
